{
  "name": "antigravity-customizations-manager",
  "displayName": "Gestor de Tokens IA (MCP Servers, Skills e Rules)",
  "description": "Painel lateral visual com botões liga/desliga estilo Mac/iOS para Servidores MCP, Skills e Regras no Antigravity e VS Code, economizando tokens e evitando estouro de contexto.",
  "version": "1.1.1",
  "publisher": "escola-sinc",
  "author": {
    "name": "Alexandre Sousa Dias Junior / Escola SINC",
    "url": "https://escolasinc.com.br"
  },
  "license": "MIT",
  "homepage": "https://github.com/jrdiiaas/antigravity-customizations-manager#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrdiiaas/antigravity-customizations-manager.git"
  },
  "bugs": {
    "url": "https://github.com/jrdiiaas/antigravity-customizations-manager/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "gestor-de-tokens",
    "token-budget",
    "antigravity",
    "google-antigravity",
    "mcp",
    "skills",
    "rules",
    "gemini",
    "context-window",
    "token-saver"
  ],
  "main": "./src/extension.js",
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-customizations-container",
          "title": "Gestor de Tokens IA",
          "icon": "resources/lightning.svg"
        }
      ]
    },
    "views": {
      "antigravity-customizations-container": [
        {
          "type": "webview",
          "id": "antigravityCustomizationsView",
          "name": "Gestor de Tokens IA",
          "icon": "resources/lightning.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity-customizations.refresh",
        "title": "Recarregar Customizações",
        "category": "Gestor de Tokens",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravity-customizations.disableAllMcp",
        "title": "Desativar Todos os MCPs (Economizar Tokens)",
        "category": "Gestor de Tokens"
      },
      {
        "command": "antigravity-customizations.enableAllMcp",
        "title": "Ativar Todos os MCPs",
        "category": "Gestor de Tokens"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravity-customizations.refresh",
          "when": "view == antigravityCustomizationsView",
          "group": "navigation"
        }
      ]
    }
  }
}
